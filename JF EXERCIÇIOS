### 2. Programa: Dois valores inteiros distintos
Solicita dois valores inteiros distintos e informa qual é o maior.

```html
<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <title>Maior entre dois valores</title>
</head>
<body>
    <script>
        var n1 = Number(prompt("Digite o primeiro número:"));
        var n2 = Number(prompt("Digite o segundo número:"));

        if (n1 === n2) {
            document.write("Os números são iguais. Por favor, digite valores distintos.");
        } else if (n1 > n2) {
            document.write("O maior número é: " + n1);
        } else {
            document.write("O maior número é: " + n2);
        }
    </script>
</body>
</html>
```

