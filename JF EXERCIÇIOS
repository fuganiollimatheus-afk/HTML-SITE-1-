### 10. Programa: Comparador de dois números (identificar igualdade ou maior)
Lê dois números, imprime se são iguais ou, se diferentes, informa qual é o maior.

```html
<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <title>Comparador de Números</title>
</head>
<body>
    <script>
        var n1 = Number(prompt("Digite o primeiro número:"));
        var n2 = Number(prompt("Digite o segundo número:"));

        if (n1 === n2) {
            document.write("Os números são iguais.");
        } else {
            document.write("Os números são diferentes.<br>");
            if (n1 > n2) {
                document.write("O maior número é o 1º: " + n1);
            } else {
                document.write("O maior número é o 2º: " + n2);
            }
        }
    </script>
</body>
</html>
```

