### 11. Programa: Valor total da compra e desconto/acréscimo de três produtos
Calcula o valor considerando a forma de pagamento selecionada.

```html
<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <title>Simulador de Compra</title>
</head>
<body>
    <script>
        var p1 = Number(prompt("Valor do 1º produto:"));
        var p2 = Number(prompt("Valor do 2º produto:"));
        var p3 = Number(prompt("Valor do 3º produto:"));
        var formaPagamento = prompt("Forma de pagamento (dinheiro, pix, ou outro):").toLowerCase();

        var valorTotal = p1 + p2 + p3;
        var valorFinal = 0;
        var alteracao = 0;

        switch (formaPagamento) {
            case "dinheiro":
                alteracao = valorTotal * 0.10; // 10% de desconto
                valorFinal = valorTotal - alteracao;
                break;
            case "pix":
                alteracao = 0; // Sem alteração
                valorFinal = valorTotal;
                break;
            default: // Qualquer outro tipo
                alteracao = valorTotal * 0.05; // 5% de acréscimo
                valorFinal = valorTotal + alteracao;
                break;
        }

        document.write("<h2>Resumo da Compra:</h2>");
        document.write("Valor total sem desconto/acréscimo: R$ " + valorTotal.toFixed(2) + "<br>");
        if (formaPagamento === "dinheiro") {
            document.write("Desconto aplicado: R$ " + alteracao.toFixed(2) + "<br>");
        } else if (formaPagamento === "pix") {
            document.write("Alteração: R$ 0.00 (PIX)<br>");
        } else {
            document.write("Acréscimo aplicado: R$ " + alteracao.toFixed(2) + "<br>");
        }
        document.write("<strong>Valor final a ser pago: R$ " + valorFinal.toFixed(2) + "</strong>");
    </script>
</body>
</html>
```
