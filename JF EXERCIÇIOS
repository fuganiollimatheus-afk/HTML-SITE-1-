### 7. Programa: Ler nome e sexo de 5 pessoas
Informa se é homem ou mulher para cada uma e, no final, apresenta o total.

```html
<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <title>Contador de Sexo</title>
</head>
<body>
    <script>
        var totalHomens = 0;
        var totalMulheres = 0;

        for (var i = 1; i <= 5; i++) {
            var nome = prompt("Digite o nome da pessoa " + i + " de 5:");
            var sexo = prompt("Digite o sexo (M para Masculino / F para Feminino):").toUpperCase();

            if (sexo === "M") {
                document.write(nome + " é Homem.<br>");
                totalHomens++;
            } else if (sexo === "F") {
                document.write(nome + " é Mulher.<br>");
                totalMulheres++;
            } else {
                document.write(nome + " possui sexo não reconhecido.<br>");
            }
        }

        document.write("<hr>");
        document.write("Total de homens: " + totalHomens + "<br>");
        document.write("Total de mulheres: " + totalMulheres);
    </script>
</body>
</html>
```

