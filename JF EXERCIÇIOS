### 4. Programa: Cálculo de média e menção do aluno
Recebe o nome e três notas, calcula a média e apresenta o resultado conforme a menção.

```html
<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <title>Média do Aluno</title>
</head>
<body>
    <script>
        var nome = prompt("Digite o nome do aluno:");
        var n1 = Number(prompt("Digite a nota 1:"));
        var n2 = Number(prompt("Digite a nota 2:"));
        var n3 = Number(prompt("Digite a nota 3:"));

        var media = (n1 + n2 + n3) / 3;

        document.write("Aluno: " + nome + "<br>");
        document.write("Média: " + media.toFixed(2) + "<br>");

        if (media >= 6.0) {
            document.write("Menção: Aprovado");
        } else if (media >= 4.0 && media < 6.0) {
            document.write("Menção: Recuperação");
        } else {
            document.write("Menção: Reprovado");
        }
    </script>
</body>
</html>
```

