### 8. Programa: Análise de custo e venda de 5 produtos
Mostra o resultado para cada produto e calcula a média dos preços.

```html
<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <title>Análise de Produtos</title>
</head>
<body>
    <script>
        var somaCusto = 0;
        var somaVenda = 0;

        document.write("<h2>Resultado por Produto:</h2>");
        for (var i = 1; i <= 5; i++) {
            var custo = Number(prompt("Preço de custo do produto " + i + ":"));
            var venda = Number(prompt("Preço de venda do produto " + i + ":"));

            somaCusto += custo;
            somaVenda += venda;

            var resultado = venda - custo;

            if (resultado > 0) {
                document.write("Produto " + i + ": Lucro de R$ " + resultado.toFixed(2) + "<br>");
            } else if (resultado < 0) {
                document.write("Produto " + i + ": Prejuízo de R$ " + Math.abs(resultado).toFixed(2) + "<br>");
            } else {
                document.write("Produto " + i + ": Empate<br>");
            }
        }

        var mediaCusto = somaCusto / 5;
        var mediaVenda = somaVenda / 5;

        document.write("<hr>");
        document.write("Média do preço de custo: R$ " + mediaCusto.toFixed(2) + "<br>");
        document.write("Média do preço de venda: R$ " + mediaVenda.toFixed(2));
    </script>
</body>
</html>
```

