* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: cursive;
    color: chocolate;
    line-height: 1.6;
    background-color: #fcf8f2;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

.site-header {
    background-color: #4d8b55;
    color: white;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
}

.site-header h1 {
    font-size: 24px;
}

/* Estrutura da lista */
.main-nav ul {
    display: flex;
    list-style: none;
    gap: 24px; /* Espaçamento ajustado para caber mais itens */
    align-items: center;
}

.main-nav a {
    color: white;
    text-decoration: none;
    font-weight: bold;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
}

.main-nav i {
    font-style: normal;
    font-size: 14px;
    opacity: 0.8;
}

.status-container span {
    background-color: #3a6d42;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 14px;
}

.main-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: 1;
    padding: 40px;
    text-align: center;
}

.main-content img {
    max-width: 300px;
    margin-bottom: 20px;
    border-radius: 8px;
}

.link-site {
    margin-top: 20px;
    padding: 12px 24px;
    background-color: #4d8b55;
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: bold;
    transition: background-color 0.3s ease;
}

.link-site:hover {
    background-color: #3a6d42;
}
