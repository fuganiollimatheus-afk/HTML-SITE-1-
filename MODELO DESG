/* Reset básico para garantir um espaçamento uniforme */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #fafafa;
    color: #333;
}

/* Estilização do Header */
.header {
    background-color: #004080; /* Azul institucional */
    color: #ffffff;
    padding: 20px 0;
    text-align: center;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
}

/* Estilização da Navbar (Barra de navegação) */
.nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #ffffff;
    padding: 15px 50px;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
}

.nav img {
    height: 40px; /* Ajuste do tamanho do logótipo */
    width: auto;
}

/* Lista de navegação */
.nav .menu-lista {
    display: flex;
    list-style: none;
}

.nav .menu-lista li {
    margin-left: 30px;
}

.nav .menu-lista li a {
    text-decoration: none;
    color: #333;
    font-weight: 500;
    font-size: 16px;
    transition: color 0.3s ease;
}

/* Efeito ao passar o rato nos links */
.nav .menu-lista li a:hover {
    color: #004080;
}

