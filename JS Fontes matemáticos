### 6. Soma de Pares (Para no -1)
```javascript
let valor, somaPares = 0;
while (valor !== -1) {
    valor = parseInt(prompt("Digite um número (-1 para sair):"));
    if (valor !== -1 && valor % 2 === 0) {
        somaPares += valor;
    }
}
console.log("Soma dos pares: " + somaPares);
```

### 7. Jogo de Adivinhação
```javascript
let secreto = 7; // Pode usar Math.floor(Math.random() * 10) + 1 para aleatório
let chute;
while (chute !== secreto) {
    chute = parseInt(prompt("Tente adivinhar o número secreto (1 a 10):"));
    if (chute < secreto) alert("Maior");
    else if (chute > secreto) alert("Menor");
    else alert("Acertou!");
}
```

### 8. Produto por Somas Sucessivas
```javascript
let a = parseInt(prompt("Digite o valor A:"));
let b = parseInt(prompt("Digite o valor B:"));
let resultado = 0, k = 0;
while (k < b) {
    resultado += a;
    k++;
}
console.log("O produto de " + a + " x " + b + " é: " + resultado);
```

### 9. Total de Compra (Para no 0)
```javascript
let preco, total = 0;
while (true) {
    preco = parseFloat(prompt("Preço do produto (0 para finalizar):"));
    if (preco === 0) break;
    total += preco;
}
console.log("Total da compra: R$ " + total.toFixed(2));
```

### 10. Ultrapassar o Valor X
```javascript
let x = parseInt(prompt("Digite o valor de X:"));
let acumulado = 0, cont = 0;
while (acumulado <= x) {
    cont++;
    acumulado += cont;
}
console.log("Último número somado: " + cont);
console.log("Total final: " + acumulado);
```

