function calcularVelocidade(distancia, tempo) {
    if (tempo <= 0) {
        return "Erro: O tempo deve ser maior que zero.";
    }
    let velocidade = distancia / tempo;
    return "A velocidade média é: " + velocidade.toFixed(2) + " km/h.";
}

