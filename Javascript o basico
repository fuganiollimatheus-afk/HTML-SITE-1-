<script type="text/javascript">
    // p1 - solicitar os termos a, b, e c
    // Use o prompt corretamente e converta para número
    var a = Number(prompt("Digite o termo a:"));
    var b = Number(prompt("Digite o termo b:"));
    var c = Number(prompt("Digite o termo c:"));

    // p2 - calcular o delta
    var delta = (b ** 2) - (4 * a * c);

    // p3 - calcular x1 e x2 
    // IMPORTANTE: Math deve ser com "M" maiúsculo e a divisão precisa de parênteses
    var x1 = (-b + Math.sqrt(delta)) / (2 * a);
    var x2 = (-b - Math.sqrt(delta)) / (2 * a);

    // p4 - exibir os resultados
    document.write("O valor de Delta é: " + delta + "<br>");
    document.write("x1 = " + x1 + "<br>");
    document.write("x2 = " + x2);
</script>
