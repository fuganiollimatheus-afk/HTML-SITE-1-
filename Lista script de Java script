6-JavaScript
let a = prompt("Informe o valor de A:");
let b = prompt("Informe o valor de B:");
let aux; // Variável auxiliar

alert("Valores originais: A=" + a + " B=" + b);

// Lógica da troca
aux = a;
a = b;
b = aux;

alert("Valores trocados: A=" + a + " B=" + b);

