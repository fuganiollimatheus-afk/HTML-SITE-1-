2-JavaScript
let num1 = Number(prompt("Informe o primeiro número:"));
let num2 = Number(prompt("Informe o segundo número:"));

alert("Soma: " + (num1 + num2) + 
      "\nSubtração: " + (num1 - num2) + 
      "\nMultiplicação: " + (num1 * num2) + 
      "\nDivisão: " + (num1 / num2));

3-JavaScript
let distancia = Number(prompt("Distância total percorrida (km):"));
let combustivel = Number(prompt("Total de combustível gasto (L):"));
let consumoMedio = distancia / combustivel;

alert("O consumo médio é de: " + consumoMedio.toFixed(2) + " km/L");

4-JavaScript
let nomeVendedor = prompt("Nome do vendedor:");
let salarioFixo = Number(prompt("Salário fixo:"));
let vendasMes = Number(prompt("Total de vendas no mês (em R$):"));

let comissao = vendasMes * 0.15;
let salarioFinal = salarioFixo + comissao;

alert("Vendedor: " + nomeVendedor + 
      "\nSalário Fixo: R$ " + salarioFixo.toFixed(2) + 
      "\nSalário Final: R$ " + salarioFinal.toFixed(2));

