/* Estilizando o texto principal da página */
body {
    font-family: 'Arial', sans-serif;
    color: #333333;
    line-height: 1.6; /* Espaçamento entre as linhas para facilitar a leitura */
    margin: 0;
}

/* Estilizando um título (h1) */
h1 {
    font-size: 32px;
    font-weight: bold;
    color: #1547ec;
    text-align: center;
}

/* Estilizando um parágrafo dentro de um card */
p {
    font-size: 16px;
    font-weight: 400; /* Peso normal */
    color: #555555;
    text-align: justify;
}

