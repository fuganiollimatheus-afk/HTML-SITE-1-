JavaScript
// Calcula o Retorno sobre Investimento
function calcularROI(ganho, custo) {
    let roi = (ganho - custo) / custo;
    return (roi * 100).toFixed(2) + "%";
}

console.log("O ROI do novo servidor é: " + calcularROI(5000, 2000));

