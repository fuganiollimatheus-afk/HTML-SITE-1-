### 4. Estrutura `SWITCH`



#### A. Programa: Simulador de Compra de 3 Produtos
```html
<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <title>Simulador de Compra</title>
</head>
<body>
    <script type="text/javascript">
        var p1 = Number(prompt("Valor do 1º produto:"));
        var p2 = Number(prompt("Valor do 2º produto:"));
        var p3 = Number(prompt("Valor do 3º produto:"));
        var formaPagamento = prompt("Forma de pagamento (dinheiro, pix ou outro):").toLowerCase();

        var valorTotal = p1 + p2 + p3;
        var valorFinal = 0;
        var descontoAcre = 0;

        switch (formaPagamento) {
            case "dinheiro":
                descontoAcre = valorTotal * 0.10;
                valorFinal = valorTotal - descontoAcre;
                break;
            case "pix":
                descontoAcre = 0;
                valorFinal = valorTotal;
                break;
            default:
                descontoAcre = valorTotal * 0.05;
                valorFinal = valorTotal + descontoAcre;
                break;
        }

        document.write("<h2>Resumo da Compra:</h2>");
        document.write("Valor total: R$ " + valorTotal.toFixed(2) + "<br>");
        document.write("Valor da alteração (desconto/acréscimo): R$ " + descontoAcre.toFixed(2) + "<br>");
        document.write("<strong>Valor final a ser pago: R$ " + valorFinal.toFixed(2) + "</strong>");
    </script>
</body>
</html>
```

#### B. Programa: Dia da Semana (1 a 7)
```html
<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <title>Dia da Semana</title>
</head>
<body>
    <script type="text/javascript">
        var dia = Number(prompt("Digite um número de 1 a 7:"));

        switch (dia) {
            case 1:
                document.write("Domingo");
                break;
            case 2:
                document.write("Segunda-feira");
                break;
            case 3:
                document.write("Terça-feira");
                break;
            case 4:
                document.write("Quarta-feira");
                break;
            case 5:
                document.write("Quinta-feira");
                break;
            case 6:
                document.write("Sexta-feira");
                break;
            case 7:
                document.write("Sábado");
                break;
            default:
                document.write("Número inválido! Digite de 1 a 7.");
        }
    </script>
</body>
</html>
```

