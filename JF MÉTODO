### 3. Estrutura `ELSE IF` (Múltiplas Condições)

#### A. Programa: Intervalo específico (maior que 80, menor que 25 ou igual a 40)
```html
<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <title>Análise de número</title>
</head>
<body>
    <script type="text/javascript">
        var numero = Number(prompt("Digite um número:"));

        if (numero > 80) {
            document.write("O número é maior que 80.");
        } else if (numero < 25) {
            document.write("O número é menor que 25.");
        } else if (numero === 40) {
            document.write("O número é igual a 40.");
        } else {
            document.write("O número não atende a nenhuma das faixas estipuladas.");
        }
    </script>
</body>
</html>
```

#### B. Programa: Média e Menção de um Aluno
```html
<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <title>Menção do Aluno</title>
</head>
<body>
    <script type="text/javascript">
        var nome = prompt("Nome do aluno:");
        var n1 = Number(prompt("Nota 1:"));
        var n2 = Number(prompt("Nota 2:"));
        var n3 = Number(prompt("Nota 3:"));
        
        var media = (n1 + n2 + n3) / 3;
        
        document.write("Aluno: " + nome + "<br>");
        document.write("Média: " + media.toFixed(2) + "<br>");
        
        if (media >= 6.0) {
            document.write("Menção: Aprovado");
        } else if (media >= 4.0 && media < 6.0) {
            document.write("Menção: Recuperação");
        } else {
            document.write("Menção: Reprovado");
        }
    </script>
</body>
</html>
```

