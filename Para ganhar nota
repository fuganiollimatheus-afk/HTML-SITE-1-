<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>A Chave - Software 1</title>
    <style>
        body { font-family: Arial, sans-serif; background-color: #f4f6f9; padding: 20px; }
        .box { max-width: 500px; margin: auto; background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
        h1 { color: #004080; font-size: 22px; text-align: center; }
        input, select, button { width: 100%; padding: 10px; margin: 8px 0; box-sizing: border-box; }
        button { background-color: #004080; color: white; border: none; border-radius: 4px; cursor: pointer; }
    </style>
</head>
<body>
    <div class="box">
        <h1>Simulador Financeiro</h1>
        <label>Valor da Compra (R$):</label>
        <input type="number" id="valor" placeholder="Ex: 100">
        
        <label>Forma de Pagamento:</label>
        <select id="pagamento">
            <option value="dinheiro">Dinheiro</option>
            <option value="pix">PIX</option>
            <option value="debito">Cartão de Débito</option>
            <option value="credito">Cartão de Crédito</option>
        </select>
        
        <button onclick="calcular()">Processar</button>
        <p id="resultado"></p>
    </div>

    <script>
        function calcular() {
            var valor = Number(document.getElementById("valor").value);
            var metodo = document.getElementById("pagamento").value;
            var final = 0, alteracao = 0;

            switch(metodo) {
                case "dinheiro":
                    alteracao = valor * 0.05;
                    final = valor - alteracao;
                    break;
                case "pix":
                    final = valor;
                    break;
                case "debito":
                    alteracao = valor * 0.05;
                    final = valor + alteracao;
                    break;
                case "credito":
                    alteracao = valor * 0.10;
                    final = valor + alteracao;
                    break;
            }
            document.getElementById("resultado").innerHTML = "Total: R$ " + final.toFixed(2);
        }
    </script>
</body>
</html>




<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Software 2 - Velocidade</title>
    <style>
        body { font-family: Arial, sans-serif; background-color: #f4f6f9; padding: 20px; }
        .box { max-width: 500px; margin: auto; background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
    </style>
</head>
<body>
    <div class="box">
        <h2>Cálculo de Velocidade</h2>
        <label>Distância (km):</label>
        <input type="number" id="distancia">
        <label>Tempo (horas):</label>
        <input type="number" id="tempo">
        <button onclick="calcVelocidade()">Calcular</button>
        <p id="resVelocidade"></p>
    </div>
    <script>
        function calcVelocidade() {
            var d = Number(document.getElementById('distancia').value);
            var t = Number(document.getElementById('tempo').value);
            if (t > 0) {
                var v = d / t;
                document.getElementById('resVelocidade').innerHTML = "Velocidade: " + v.toFixed(2) + " km/h";
            } else {
                document.getElementById('resVelocidade').innerHTML = "Erro: O tempo deve ser maior que zero.";
            }
        }
    </script>
</body>
</html>



